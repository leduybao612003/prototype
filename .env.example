# VLearn Prototype — môi trường
# Copy thành .env.local, điền giá trị thật. Không commit .env.local.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Chỉ server, chỉ khi cần (không NEXT_PUBLIC):
SUPABASE_SECRET_KEY=

# AI (server-only, không NEXT_PUBLIC):
# mock = demo mô phỏng, không cần key (mặc định). live = gọi provider thật.
AI_MODE=mock
AI_PROVIDER=
AI_PROVIDER_API_KEY=
AI_BASE_URL=
AI_TEXT_MODEL=
AI_VISION_MODEL=
APP_URL=http://localhost:3000
AI_REQUEST_LIMIT_PER_MINUTE=20
AI_DAILY_BUDGET=

# Trạng thái hiện tại: chưa có credential → API ghi + AI trả 503 BLOCKED có mã lỗi,
# UI hiển thị trạng thái thật, không fake success. Ghi tên biến còn thiếu cuối báo cáo.
